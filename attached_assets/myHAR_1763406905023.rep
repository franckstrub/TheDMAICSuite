powerLower2 = jStat.chisquare.cdf(scaledLower, df);\n          const powerUpper2 = 1 - jStat.chisquare.cdf(scaledUpper, df);\n          power = powerLower2 + powerUpper2;\n          break;\n      }\n      return Math.max(0, Math.min(1, power));\n    } catch (error) {\n      console.error(\"Error calculating power:\", error);\n      return 0;\n    }\n  }\n  let lowerBound = 2;\n  let upperBound = 50;\n  while (calculatePowerForN(upperBound) < oneSVariancePower && upperBound < 1e4) {\n    upperBound = Math.min(upperBound * 2, upperBound + 100);\n  }\n  if (calculatePowerForN(upperBound) < oneSVariancePower) {\n    upperBound = 1e4;\n    const maxPower = calculatePowerForN(upperBound);\n    if (maxPower < oneSVariancePower) {\n      return {\n        sampleSize: upperBound,\n        actualPower: Math.round(maxPower * 1e4) / 1e4\n      };\n    }\n  }\n  let bestN = upperBound;\n  while (upperBound - lowerBound > 1) {\n    const midN = Math.floor((lowerBound + upperBound) / 2);\n    const power = calculatePowerForN(midN);\n    if (power >= oneSVariancePower) {\n      bestN = midN;\n      upperBound = midN;\n    } else {\n      lowerBound = midN;\n    }\n  }\n  const powerLower = calculatePowerForN(lowerBound);\n  const powerUpper = calculatePowerForN(upperBound);\n  if (powerLower >= oneSVariancePower) {\n    bestN = lowerBound;\n  } else if (powerUpper >= oneSVariancePower) {\n    bestN = upperBound;\n  }\n  const actualPower = calculatePowerForN(bestN);\n  return {\n    sampleSize: bestN,\n    actualPower: Math.round(actualPower * 1e4) / 1e4\n  };\n}\nexport function calculate2SMeanSampleSize(power2SMeanPower, power2SMeanHa, power2SMeanMean1, power2SMeanMean2, power2SMeanStdev, power2SMeanAlpha) {\n  const targetPower = parseFloat(power2SMeanPower);\n  const alpha = parseFloat(power2SMeanAlpha);\n  if (targetPower <= 0 || targetPower >= 1) {\n    throw new Error(\"Power must be between 0 and 1\");\n  }\n  if (alpha <= 0 || alpha >= 1) {\n    throw new Error(\"Alpha must be between 0 and 1\");\n  }\n  if (power2SMeanStdev <= 0) {\n    return { sampleSize: 0, actualPower: 0 };\n  }\n  const meanDifference = Math.abs(power2SMeanMean1 - power2SMeanMean2);\n  const effectSize = meanDifference / power2SMeanStdev;\n  const isGroup1Greater = power2SMeanMean1 > power2SMeanMean2;\n  function getCriticalValues(df) {\n    let tLower = -Infinity;\n    let tUpper = Infinity;\n    switch (power2SMeanHa) {\n      case \"<\":\n        tLower = jStat.studentt.inv(alpha, df);\n        break;\n      case \">\":\n        tUpper = jStat.studentt.inv(1 - alpha, df);\n        break;\n      case \"≠\":\n      default:\n        tLower = jStat.studentt.inv(alpha / 2, df);\n        tUpper = jStat.studentt.inv(1 - alpha / 2, df);\n        break;\n    }\n    return { tLower, tUpper };\n  }\n  function calculatePowerForN(nPerGroup) {\n    if (nPerGroup < 2) return 0;\n    const df = 2 * nPerGroup - 2;\n    const standardError = power2SMeanStdev * Math.sqrt(2 / nPerGroup);\n    try {\n      const delta = meanDifference / standardError;\n      const signedDelta = power2SMeanHa === \"<\" ? isGroup1Greater ? -delta : delta : isGroup1Greater ? delta : -delta;\n      const { tLower, tUpper } = getCriticalValues(df);\n      let power = 0;\n      switch (power2SMeanHa) {\n        case \"<\":\n          if (df >= 30) {\n            const adjustedT = tLower - signedDelta;\n            power = jStat.normal.cdf(adjustedT, 0, 1);\n          } else {\n            const adjustedT = (tLower - signedDelta) / Math.sqrt(1 + signedDelta * signedDelta / (2 * df));\n            power = jStat.studentt.cdf(adjustedT, df);\n          }\n          break;\n        case \">\":\n          if (df >= 30) {\n            const adjustedT = tUpper - signedDelta;\n            power = 1 - jStat.normal.cdf(adjustedT, 0, 1);\n          } else {\n            const adjustedT = (tUpper - signedDelta) / Math.sqrt(1 + signedDelta * signedDelta / (2 * df));\n            power = 1 - jStat.studentt.cdf(adjustedT, df);\n          }\n          break;\n        case \"≠\":\n        default:\n          if (df >= 30) {\n            const adjustedTLower = tLower - signedDelta;\n            const adjustedTUpper = tUpper - signedDelta;\n            const powerLower2 = jStat.normal.cdf(adjustedTLower, 0, 1);\n            const powerUpper2 = 1 - jStat.normal.cdf(adjustedTUpper, 0, 1);\n            power = powerLower2 + powerUpper2;\n          } else {\n            const adjustmentFactor = Math.sqrt(1 + signedDelta * signedDelta / (2 * df));\n            const adjustedTLower = (tLower - signedDelta) / adjustmentFactor;\n            const adjustedTUpper = (tUpper - signedDelta) / adjustmentFactor;\n            const powerLower2 = jStat.studentt.cdf(adjustedTLower, df);\n            const powerUpper2 = 1 - jStat.studentt.cdf(adjustedTUpper, df);\n            power = powerLower2 + powerUpper2;\n          }\n          break;\n      }\n      return Math.max(0, Math.min(1, power));\n    } catch (error) {\n      console.error(\"Error calculating power:\", error);\n      return 0;\n    }\n  }\n  function calculatePowerForNSimple(nPerGroup) {\n    if (nPerGroup < 2) return 0;\n    const df = 2 * nPerGroup - 2;\n    try {\n      const se = power2SMeanStdev * Math.sqrt(2 / nPerGroup);\n      const delta = meanDifference / se;\n      let tCritical;\n      let power = 0;\n      switch (power2SMeanHa) {\n        case \"<\":\n          tCritical = jStat.studentt.inv(alpha, df);\n          power = jStat.normal.cdf(tCritical + delta, 0, 1);\n          break;\n        case \">\":\n          tCritical = jStat.studentt.inv(1 - alpha, df);\n          power = 1 - jStat.normal.cdf(tCritical - delta, 0, 1);\n          break;\n        case \"≠\":\n        default:\n          tCritical = jStat.studentt.inv(1 - alpha / 2, df);\n          const powerUpper2 = 1 - jStat.normal.cdf(tCritical - delta, 0, 1);\n          const powerLower2 = jStat.normal.cdf(-tCritical - delta, 0, 1);\n          power = powerUpper2 + powerLower2;\n          break;\n      }\n      return Math.max(0, Math.min(1, power));\n    } catch (error) {\n      console.error(\"Error in simple power calculation:\", error);\n      return 0;\n    }\n  }\n  let lowerBound = 2;\n  let upperBound = 50;\n  while (calculatePowerForNSimple(upperBound) < targetPower && upperBound < 1e4) {\n    upperBound = Math.min(upperBound * 2, upperBound + 100);\n  }\n  if (calculatePowerForNSimple(upperBound) < targetPower) {\n    upperBound = 1e4;\n    const maxPower = calculatePowerForNSimple(upperBound);\n    if (maxPower < targetPower) {\n      return {\n        sampleSize: upperBound,\n        actualPower: Math.round(maxPower * 1e4) / 1e4\n      };\n    }\n  }\n  let bestN = upperBound;\n  while (upperBound - lowerBound > 1) {\n    const midN = Math.floor((lowerBound + upperBound) / 2);\n    const power = calculatePowerForNSimple(midN);\n    if (power >= targetPower) {\n      bestN = midN;\n      upperBound = midN;\n    } else {\n      lowerBound = midN;\n    }\n  }\n  const powerLower = calculatePowerForNSimple(lowerBound);\n  const powerUpper = calculatePowerForNSimple(upperBound);\n  if (powerLower >= targetPower) {\n    bestN = lowerBound;\n  } else if (powerUpper >= targetPower) {\n    bestN = upperBound;\n  }\n  const actualPower = calculatePowerForNSimple(bestN);\n  return {\n    sampleSize: bestN,\n    // Sample size per group\n    actualPower: Math.round(actualPower * 1e4) / 1e4\n  };\n}\n;\nexport function calculate2SVarianceSampleSize(power2SVariancePower, power2SVarianceHa, power2SVarianceStdev1, power2SVarianceStdev2, power2SVarianceAlpha) {\n  const targetPower = parseFloat(power2SVariancePower);\n  const alpha = parseFloat(power2SVarianceAlpha);\n  if (targetPower <= 0 || targetPower >= 1) {\n    return { sampleSize: 0, actualPower: 0 };\n  }\n  if (alpha <= 0 || alpha >= 1) {\n    return { sampleSize: 0, actualPower: 0 };\n  }\n  if (typeof power2SVarianceStdev1 !== \"number\" || isNaN(power2SVarianceStdev1) || power2SVarianceStdev1 <= 0) {\n    return { sampleSize: 0, actualPower: 0 };\n  }\n  if (typeof power2SVarianceStdev2 !== \"number\" || isNaN(power2SVarianceStdev2) || power2SVarianceStdev2 <= 0) {\n    return { sampleSize: 0, actualPower: 0 };\n  }\n  if (power2SVarianceStdev1 === power2SVarianceStdev2) {\n    return { sampleSize: 0, actualPower: 0 };\n  }\n  const sigma1Squared = power2SVarianceStdev1 * power2SVarianceStdev1;\n  const sigma2Squared = power2SVarianceStdev2 * power2SVarianceStdev2;\n  const varianceRatio = sigma1Squared / sigma2Squared;\n  function getCriticalValues(df1, df2) {\n    let fLower = 0;\n    let fUpper = Infinity;\n    try {\n      switch (power2SVarianceHa) {\n        case \"<\":\n          fUpper = jStat.centralF.inv(alpha, df1, df2);\n          break;\n        case \">\":\n          fLower = jStat.centralF.inv(1 - alpha, df1, df2);\n          break;\n        case \"≠\":\n        default:\n          fLower = jStat.centralF.inv(alpha / 2, df1, df2);\n          fUpper = jStat.centralF.inv(1 - alpha / 2, df1, df2);\n          break;\n      }\n    } catch (error) {\n      console.error(\"Error calculating critical F-values:\", error);\n    }\n    return { fLower, fUpper };\n  }\n  function calculatePowerForN(nPerGroup) {\n    if (nPerGroup < 2) return 0;\n    const df1 = nPerGroup - 1;\n    const df2 = nPerGroup - 1;\n    try {\n      const { fLower, fUpper } = getCriticalValues(df1, df2);\n      let power = 0;\n      switch (power2SVarianceHa) {\n        case \"<\":\n          const scaledFUpperLess = fUpper / varianceRatio;\n          power = jStat.centralF.cdf(scaledFUpperLess, df1, df2);\n          break;\n        case \">\":\n          const scaledFLowerGreater = fLower / varianceRatio;\n          power = 1 - jStat.centralF.cdf(scaledFLowerGreater, df1, df2);\n          break;\n        case \"≠\":\n        default:\n          const scaledFLower = fLower / varianceRatio;\n          const scaledFUpper = fUpper / varianceRatio;\n          const powerLower2 = jStat.centralF.cdf(scaledFLower, df1, df2);\n          const powerUpper2 = 1 - jStat.centralF.cdf(scaledFUpper, df1, df2);\n          power = powerLower2 + powerUpper2;\n          break;\n      }\n      return Math.max(0, Math.min(1, power));\n    } catch (error) {\n      console.error(\"Error calculating power:\", error);\n      return 0;\n    }\n  }\n  let lowerBound = 2;\n  let upperBound = 50;\n  while (calculatePowerForN(upperBound) < targetPower && upperBound < 5e3) {\n    upperBound = Math.min(upperBound * 2, upperBound + 100);\n  }\n  if (calculatePowerForN(upperBound) < targetPower) {\n    upperBound = 5e3;\n    const maxPower = calculatePowerForN(upperBound);\n    if (maxPower < targetPower) {\n      return {\n        sampleSize: upperBound,\n        actualPower: Math.round(maxPower * 1e4) / 1e4\n      };\n    }\n  }\n  let bestN = upperBound;\n  while (upperBound - lowerBound > 1) {\n    const midN = Math.floor((lowerBound + upperBound) / 2);\n    const power = calculatePowerForN(midN);\n    if (power >= targetPower) {\n      bestN = midN;\n      upperBound = midN;\n    } else {\n      lowerBound = midN;\n    }\n  }\n  const powerLower = calculatePowerForN(lowerBound);\n  const powerUpper = calculatePowerForN(upperBound);\n  if (powerLower >= targetPower) {\n    bestN = lowerBound;\n  } else if (powerUpper >= targetPower) {\n    bestN = upperBound;\n  }\n  const actualPower = calculatePowerForN(bestN);\n  return {\n    sampleSize: bestN,\n    // Sample size per group\n    actualPower: Math.round(actualPower * 1e4) / 1e4\n  };\n}\n;\nexport function calculate2StCriticalValue(significance, degreesOfFreedom, alternativemean) {\n  if (significance <= 0 || significance >= 1) {\n    throw new Error(\"Significance level must be between 0 and 1\");\n  }\n  if (degreesOfFreedom <= 0) {\n    throw new Error(\"Degrees of freedom must be positive\");\n  }\n  let tCriteria;\n  switch (alternativemean) {\n    case \"Less than\":\n      tCriteria = jStat.studentt.inv(significance, degreesOfFreedom);\n      break;\n    case \"Greater than\":\n      tCriteria = jStat.studentt.inv(1 - significance, degreesOfFreedom);\n      break;\n    case \"Different\":\n      const tCrit = jStat.studentt.inv(1 - significance / 2, degreesOfFreedom);\n      tCriteria = { lower: -tCrit, upper: tCrit };\n      break;\n    default:\n      throw new Error(\"Invalid alternative hypothesis\");\n  }\n  return tCriteria;\n}\n;\nexport function calculate2SMeanPValue(tStatistic, degreesOfFreedom, alternativemean) {\n  if (degreesOfFreedom <= 0) {\n    throw new Error(\"Degrees of freedom must be positive\");\n  }\n  let tp_Value;\n  switch (alternativemean) {\n    case \"Less than\":\n      tp_Value = jStat.studentt.cdf(tStatistic, degreesOfFreedom);\n      break;\n    case \"Greater than\":\n      tp_Value = 1 - jStat.studentt.cdf(tStatistic, degreesOfFreedom);\n      break;\n    case \"Different\":\n      tp_Value = 2 * (1 - jStat.studentt.cdf(Math.abs(tStatistic), degreesOfFreedom));\n      break;\n    default:\n      throw new Error(\"Invalid alternative hypothesis\");\n  }\n  return tp_Value;\n}\n;\nexport function calculate2SDiffConfidenceInterval(difference, pooledSE, tCriteria, alternativemean) {\n  let diffCI_minus = 0;\n  let diffCI_plus = 0;\n  switch (alternativemean) {\n    case \"Less than\":\n      diffCI_minus = -Infinity;\n      if (typeof tCriteria === \"number\") {\n        diffCI_plus = difference + tCriteria * pooledSE;\n      }\n      break;\n    case \"Greater than\":\n      if (typeof tCriteria === \"number\") {\n        diffCI_minus = difference - tCriteria * pooledSE;\n      }\n      diffCI_plus = Infinity;\n      break;\n    case \"Different\":\n      if (typeof tCriteria === \"object\") {\n        diffCI_minus = difference - tCriteria.upper * pooledSE;\n        diffCI_plus = difference + tCriteria.upper * pooledSE;\n      }\n      ;\n      break;\n    default:\n      if (typeof tCriteria === \"object\") {\n        diffCI_minus = difference - tCriteria.upper * pooledSE;\n        diffCI_plus = difference + tCriteria.upper * pooledSE;\n      } else {\n        diffCI_minus = difference - tCriteria * pooledSE;\n        diffCI_plus = difference + tCriteria * pooledSE;\n      }\n      ;\n      break;\n  }\n  if (diffCI_minus > diffCI_plus) {\n    const low = diffCI_plus;\n    diffCI_plus = diffCI_minus;\n    diffCI_minus = low;\n  }\n  return {\n    lower1: diffCI_minus,\n    upper1: diffCI_plus\n  };\n}\n;\nexport function calculateSampleStats(data) {\n  const n = data.length;\n  const mean2 = jStat.mean(data);\n  const variance2 = jStat.variance(data);\n  const standardError = Math.sqrt(variance2 / n);\n  return { mean: mean2, variance: variance2, standardError, n };\n}\nexport function testEqualVariances(var1, var2, n1, n2, alpha) {\n  const fStat = Math.max(var1, var2) / Math.min(var1, var2);\n  const df1 = Math.max(var1, var2) === var1 ? n1 - 1 : n2 - 1;\n  const df2 = Math.max(var1, var2) === var1 ? n2 - 1 : n1 - 1;\n  const fCritical = jStat.centralF.inv(1 - alpha / 2, df1, df2);\n  const pValue = 2 * (1 - jStat.centralF.cdf(fStat, df1, df2));\n  return { fStat, fCritical, pValue, equalVariances: fStat <= fCritical };\n}\nexport function calculate2SvarFisherValue(var1, var2, ratioVariance0) {\n  const observedRatio = var1 / var2;\n  return observedRatio / ratioVariance0;\n}\nexport function calculate2SvarFisherCriticalValue(significance, df1, df2, alternativevariance) {\n  switch (alternativevariance) {\n    case \"Less than\":\n      return jStat.centralF.inv(significance, df1, df2);\n    case \"Greater than\":\n      return jStat.centralF.inv(1 - significance, df1, df2);\n    case \"Different\":\n      const fLower = jStat.centralF.inv(significance / 2, df1, df2);\n      const fUpper = jStat.centralF.inv(1 - significance / 2, df1, df2);\n      return { lower: fLower, upper: fUpper };\n    default:\n      throw new Error(\"Invalid alternative hypothesis\");\n  }\n}\nexport function calculate2SvarFisherPValue(fStat, df1, df2, alternativevariance) {\n  switch (alternativevariance) {\n    case \"Less than\":\n      return jStat.centralF.cdf(fStat, df1, df2);\n    case \"Greater than\":\n      return 1 - jStat.centralF.cdf(fStat, df1, df2);\n    case \"Different\":\n      const leftTail = jStat.centralF.cdf(fStat, df1, df2);\n      const rightTail = 1 - jStat.centralF.cdf(fStat, df1, df2);\n      return 2 * Math.min(leftTail, rightTail);\n    default:\n      throw new Error(\"Invalid alternative hypothesis\");\n  }\n}\nexport function calculate2SvarFisherConfidenceInterval(var1, var2, df1, df2, significance) {\n  const alpha = significance;\n  const fLower = jStat.centralF.inv(alpha / 2, df1, df2);\n  const fUpper = jStat.centralF.inv(1 - alpha / 2, df1, df2);\n  const ratio = var1 / var2;\n  return {\n    lower: ratio / fUpper,\n    upper: ratio / fLower\n  };\n}\nexport function calculate2SvarLeveneValue(data1, data2) {\n  const median1 = jStat.median(data1);\n  const median2 = jStat.median(data2);\n  const deviations1 = data1.map((x) => Math.abs(x - median1));\n  const deviations2 = data2.map((x) => Math.abs(x - median2));\n  const n1 = data1.length;\n  const n2 = data2.length;\n  const n = n1 + n2;\n  const meanDev1 = jStat.mean(deviations1);\n  const meanDev2 = jStat.mean(deviations2);\n  const grandMeanDev = (n1 * meanDev1 + n2 * meanDev2) / n;\n  const ssBetween = n1 * Math.pow(meanDev1 - grandMeanDev, 2) + n2 * Math.pow(meanDev2 - grandMeanDev, 2);\n  const ssWithin1 = deviations1.reduce((sum, dev) => sum + Math.pow(dev - meanDev1, 2), 0);\n  const ssWithin2 = deviations2.reduce((sum, dev) => sum + Math.pow(dev - meanDev2, 2), 0);\n  const ssWithin = ssWithin1 + ssWithin2;\n  const msBetween = ssBetween / (2 - 1);\n  const msWithin = ssWithin / (n - 2);\n  return msBetween / msWithin;\n}\nexport function calculate2SvarLeveneCriticalValue(significance, df1, df2, alternativevariance) {\n  switch (alternativevariance) {\n    case \"Less than\":\n      return jStat.centralF.inv(significance, df1, df2);\n    case \"Greater than\":\n      return jStat.centralF.inv(1 - significance, df1, df2);\n    case \"Different\":\n      const fLower = jStat.centralF.inv(significance / 2, df1, df2);\n      const fUpper = jStat.centralF.inv(1 - significance / 2, df1, df2);\n      return { lower: fLower, upper: fUpper };\n    default:\n      throw new Error(\"Invalid alternative hypothesis\");\n  }\n}\nexport function calculate2SvarLevenePValue(fStat, df1, df2, alternativevariance) {\n  switch (alternativevariance) {\n    case \"Less than\":\n      return jStat.centralF.cdf(fStat, df1, df2);\n    case \"Greater than\":\n      return 1 - jStat.centralF.cdf(fStat, df1, df2);\n    case \"Different\":\n      const leftTail = jStat.centralF.cdf(fStat, df1, df2);\n      const rightTail = 1 - jStat.centralF.cdf(fStat, df1, df2);\n      return 2 * Math.min(leftTail, rightTail);\n    default:\n      throw new Error(\"Invalid alternative hypothesis\");\n  }\n}\nexport function calculate2SvarLeveneConfidenceInterval(data1, data2, significance) {\n  const var1 = variance(data1);\n  const var2 = variance(data2);\n  const ratio = var1 / var2;\n  let constant;\n  switch (significance) {\n    case 0.01:\n      constant = 3.29;\n      break;\n    case 0.05:\n      constant = 1.96;\n      break;\n    case 0.1:\n      constant = 1.645;\n      break;\n    default:\n      constant = 1.96;\n      break;\n  }\n  const margin = constant * Math.sqrt(ratio);\n  return {\n    lower: Math.max(0, ratio - margin),\n    upper: ratio + margin\n  };\n}\n;\nexport function calculate2SMeanConfidenceInterval(significance, stats1, stats2) {\n  if (significance <= 0 || significance >= 1) {\n    throw new Error(\"Significance level must be between 0 and 1\");\n  }\n  const tCI = jStat.studentt.inv(1 - significance / 2, stats1.n - 1);\n  const tCI2 = jStat.studentt.inv(1 - significance / 2, stats2.n - 1);\n  const mean1CI_minus = stats1.mean - tCI * stats1.standardError;\n  const mean1CI_plus = stats1.mean + tCI * stats1.standardError;\n  const mean2CI_minus = stats2.mean - tCI2 * stats2.standardError;\n  const mean2CI_plus = stats2.mean + tCI2 * stats2.standardError;\n  return {\n    lower1: mean1CI_minus,\n    upper1: mean1CI_plus,\n    lower2: mean2CI_minus,\n    upper2: mean2CI_plus\n  };\n}\n;\nexport function calculateMedian(data) {\n  if (data.length === 0) return 0;\n  const sorted = [...data].sort((a, b) => a - b);\n  const n = sorted.length;\n  return n % 2 === 0 ? (sorted[n / 2 - 1] + sorted[n / 2]) / 2 : sorted[Math.floor(n / 2)];\n}\nexport function calculate2SMedianStatistic(dataValues1, dataValues2, alternativemedian) {\n  const n1 = dataValues1.length;\n  const n2 = dataValues2.length;\n  const combined = [\n    ...dataValues1.map((x) => ({ value: x, group: 1 })),\n    ...dataValues2.map((x) => ({ value: x, group: 2 }))\n  ];\n  combined.sort((a, b) => a.value - b.value);\n  let currentRank = 1;\n  for (let i = 0; i < combined.length; i++) {\n    let tieCount = 1;\n    while (i + tieCount < combined.length && combined[i].value === combined[i + tieCount].value) {\n      tieCount++;\n    }\n    const avgRank = currentRank + (tieCount - 1) / 2;\n    for (let j = i; j < i + tieCount; j++) {\n      combined[j].rank = avgRank;\n    }\n    currentRank += tieCount;\n    i += tieCount - 1;\n  }\n  const R1 = combined.filter((x) => x.group === 1).reduce((sum, x) => sum + (x.rank || 0), 0);\n  const U1 = R1 - n1 * (n1 + 1) / 2;\n  const U2 = n1 * n2 - U1;\n  const U = Math.min(U1, U2);\n  let testStatistic;\n  let pValue;\n  if (n1 > 8 && n2 > 8) {\n    const meanU = n1 * n2 / 2;\n    const stdU = Math.sqrt(n1 * n2 * (n1 + n2 + 1) / 12);\n    testStatistic = Math.abs(U - meanU) / stdU;\n    switch (alternativemedian) {\n      case \"Different\":\n        pValue = 2 * (1 - jStat.normal.cdf(testStatistic, 0, 1));\n        break;\n      case \"Less than\":\n        pValue = jStat.normal.cdf(testStatistic, 0, 1);\n        break;\n      case \"Greater than\":\n        pValue = 1 - jStat.normal.cdf(testStatistic, 0, 1);\n        break;\n      default:\n        pValue = 0;\n    }\n  } else {\n    testStatistic = U;\n    pValue = 0.5;\n  }\n  return {\n    testStatistic,\n    pValue\n  };\n}\nexport function calculate2SMedianCriticalValue(significance) {\n  const criticalValue = jStat.normal.inv(1 - significance / 2, 0, 1);\n  return criticalValue;\n}\n;\nexport function calculate2SMedianConfidenceInterval(dataValues1, dataValues2, significance, alternativemedian) {\n  const differences = [];\n  for (const x1 of dataValues1) {\n    for (const x2 of dataValues2) {\n      differences.push(x1 - x2);\n    }\n  }\n  differences.sort((a, b) => a - b);\n  const m = differences.length;\n  if (m === 0) {\n    return { lower: 0, upper: 0 };\n  }\n  const n1 = dataValues1.length;\n  const n2 = dataValues2.length;\n  let alpha;\n  switch (alternativemedian) {\n    case \"Different\":\n      alpha = significance;\n      break;\n    case \"Less than\":\n    case \"Greater than\":\n      alpha = significance * 2;\n      break;\n    default:\n      alpha = significance;\n  }\n  if (n1 >= 8 && n2 >= 8) {\n    const z = jStat.normal.inv(1 - alpha / 2, 0, 1);\n    const se = Math.sqrt(n1 * n2 * (n1 + n2 + 1) / 12);\n    const w = z * se;\n    const lowerIndex = Math.max(0, Math.floor((m - 1) / 2 - w));\n    const upperIndex = Math.min(m - 1, Math.ceil((m - 1) / 2 + w));\n    return {\n      lower: differences[lowerIndex],\n      upper: differences[upperIndex]\n    };\n  } else {\n    const lowerIndex = Math.max(0, Math.floor(m * alpha / 2));\n    const upperIndex = Math.min(m - 1, Math.floor(m * (1 - alpha / 2)));\n    return {\n      lower: differences[lowerIndex],\n      upper: differences[upperIndex]\n    };\n  }\n}\nexport function calculatePairedSMeanSampleSize(power1SMeanPower, power1SMeanHa, power1SMeanMean, power1SMeanH0, power1SMeanStdev, power1SMeanAlpha) {\n  const oneSMeanPower = parseFloat(power1SMeanPower);\n  const oneSMeanAlpha = parseFloat(power1SMeanAlpha);\n  if (oneSMeanPower <= 0 || oneSMeanPower >= 1) {\n    throw new Error(\"Power must be between 0 and 1\");\n  }\n  if (oneSMeanAlpha <= 0 || oneSMeanAlpha >= 1) {\n    throw new Error(\"Alpha must be between 0 and 1\");\n  }\n  if (power1SMeanStdev <= 0) {\n    return { sampleSize: 0, actualPower: 0 };\n  }\n  const effectSize = Math.abs(power1SMeanMean - power1SMeanH0) / power1SMeanStdev;\n  let zAlpha;\n  let zBeta;\n  switch (power1SMeanHa) {\n    case \"<\":\n      zAlpha = jStat.normal.inv(oneSMeanAlpha, 0, 1);\n      zBeta = jStat.normal.inv(oneSMeanPower, 0, 1);\n      break;\n    case \">\":\n      zAlpha = jStat.normal.inv(1 - oneSMeanAlpha, 0, 1);\n      zBeta = jStat.normal.inv(oneSMeanPower, 0, 1);\n      break;\n    case \"≠\":\n    default:\n      zAlpha = jStat.normal.inv(1 - oneSMeanAlpha / 2, 0, 1);\n      zBeta = jStat.normal.inv(oneSMeanPower, 0, 1);\n      break;\n  }\n  let n;\n  if (power1SMeanHa === \"≠\") {\n    n = Math.pow((zAlpha + zBeta) / effectSize, 2);\n  } else {\n    n = Math.pow((Math.abs(zAlpha) + zBeta) / effectSize, 2);\n  }\n  n = Math.ceil(n);\n  let converged = false;\n  let iterations = 0;\n  const maxIterations = 100;\n  let actualPower = 0;\n  while (!converged && iterations < maxIterations) {\n    const df = n - 1;\n    let tAlpha;\n    switch (power1SMeanHa) {\n      case \"<\":\n        tAlpha = jStat.studentt.inv(oneSMeanAlpha, df);\n        break;\n      case \">\":\n        tAlpha = jStat.studentt.inv(1 - oneSMeanAlpha, df);\n        break;\n      case \"≠\":\n      default:\n        tAlpha = jStat.studentt.inv(1 - oneSMeanAlpha / 2, df);\n        break;\n    }\n    const delta = effectSize * Math.sqrt(n);\n    if (power1SMeanHa === \"≠\") {\n      const criticalValue = Math.abs(tAlpha);\n      {\n      }\n      actualPower = 1 - jStat.studentt.cdf(criticalValue - delta, df) + jStat.studentt.cdf(-criticalValue - delta, df);\n    } else {\n      if (power1SMeanMean > power1SMeanH0) {\n        actualPower = 1 - jStat.studentt.cdf(tAlpha - delta, df);\n      } else {\n        actualPower = jStat.studentt.cdf(tAlpha + delta, df);\n      }\n    }\n    if (Math.abs(actualPower - oneSMeanPower) < 1e-3) {\n      converged = true;\n    } else if (actualPower < oneSMeanPower) {\n      n += 1;\n    } else {\n      converged = true;\n    }\n    iterations++;\n  }\n  n = Math.max(n, 2);\n  return {\n    sampleSize: n,\n    actualPower\n  };\n}\n;\nfunction old_noncentralFcdf(x, d1, d2, lambda, tol = 1e-8, maxIter = 200) {\n  let sum = 0;\n  let weight = Math.exp(-lambda / 2);\n  let j = 0;\n  let term = weight * jStat.centralF.cdf(x, d1, d2);\n  sum += term;\n  while (j < maxIter && term > tol) {\n    j++;\n    weight *= lambda / 2 / j;\n    term = weight * jStat.centralF.cdf(x, d1 + 2 * j, d2);\n    sum += term;\n  }\n  return sum;\n}\n;\nfunction GroknonCentralFCDF(x, df1, df2, ncp, maxTerms = 100) {\n  if (x < 0 || df1 <= 0 || df2 <= 0 || ncp < 0) return NaN;\n  let sum = 0;\n  const lambdaHalf = ncp / 2;\n  const epsilon = 1e-10;\n  for (let j = 0; j < maxTerms; j++) {\n    const poissonWeight = Math.exp(-lambdaHalf) * Math.pow(lambdaHalf, j) / jStat.factorial(j);\n    const betaArg = df1 * x / (df1 * x + df2);\n    const betaCDF = jStat.beta.cdf(betaArg, (df1 + 2 * j) / 2, df2 / 2);\n    const term = poissonWeight * betaCDF;\n    sum += term;\n    if (term < epsilon * sum && j > 0) break;\n  }\n  return Math.min(Math.max(sum, 0), 1);\n}\n;\nexport function calculateMultipleSMeanSampleSize(powerPower, powerNbrDistri, powerDifference, powerStdev, powerAlpha) {\n  const targetPower = parseFloat(powerPower);\n  const alpha = parseFloat(powerAlpha);\n  const k = Math.floor(powerNbrDistri);\n  const delta = powerDifference;\n  const sigma = powerStdev;\n  if (isNaN(targetPower) || targetPower <= 0 || targetPower >= 1 || isNaN(alpha) || alpha <= 0 || alpha >= 1 || k < 2 || isNaN(k) || delta <= 0 || isNaN(delta) || sigma <= 0 || isNaN(sigma)) {\n    return { sampleSize: NaN, actualPower: NaN };\n  }\n  const f = delta / (sigma * Math.sqrt(2 * k));\n  const nonCentralFCDF = (x, df12, df2, ncp, maxTerms = 100) => {\n    if (x < 0 || df12 <= 0 || df2 <= 0 || ncp < 0) return NaN;\n    let sum = 0;\n    const lambdaHalf = ncp / 2;\n    const epsilon = 1e-10;\n    for (let j = 0; j < maxTerms; j++) {\n      const poissonWeight = Math.exp(-lambdaHalf) * Math.pow(lambdaHalf, j) / jStat.factorial(j);\n      const betaArg = df12 * x / (df12 * x + df2);\n      const betaCDF = jStat.beta.cdf(betaArg, (df12 + 2 * j) / 2, df2 / 2);\n      const term = poissonWeight * betaCDF;\n      sum += term;\n      if (term < epsilon * sum && j > 0) break;\n    }\n    return Math.min(Math.max(sum, 0), 1);\n  };\n  const df1 = k - 1;\n  let n = 2;\n  let actualPower = 0;\n  const maxIterations = 1e3;\n  const powerThreshold = targetPower - 5e-3;\n  while (n < maxIterations) {\n    const df2 = k * (n - 1);\n    if (df2 <= 0) {\n      n++;\n      continue;\n    }\n    const lambda = n * k * f * f;\n    try {\n      const criticalF = jStat.centralF.inv(1 - alpha, df1, df2);\n      const cdf = nonCentralFCDF(criticalF, df1, df2, lambda);\n      actualPower = 1 - cdf;\n      if (actualPower >= powerThreshold) {\n        return {\n          sampleSize: n,\n          actualPower\n        };\n      }\n    } catch (error) {\n      console.error(\"Power calculation error:\", error);\n      return { sampleSize: NaN, actualPower: NaN };\n    }\n    n++;\n  }\n  return {\n    sampleSize: NaN,\n    actualPower: NaN\n  };\n}\nimport { multipleSVarianceTest } from \"/src/components/dmaic/multipleSVarianceTest.tsx\";\nexport function anovaOneWay(datasets, normalityResults, significanceLevel, alternative) {\n  const alpha = significanceLevel;\n  const k = datasets.length;\n  const sampleSizes = datasets.map((group) => group.length);\n  const totalN = sampleSizes.reduce((sum, n) => sum + n, 0);\n  if (k < 2) {\n    return {\n      fStatistic: 0,\n      pValue: 0,\n      dfBetween: 0,\n      dfWithin: 0,\n      ssBetween: 0,\n      ssWithin: 0,\n      msBetween: 0,\n      msWithin: 0,\n      rSquared: 0,\n      rSquaredAdj: 0,\n      rSquaredPred: 0,\n      pooledstdev: 0,\n      grandMean: 0,\n      groupMeans: [],\n      confidenceIntervals: [],\n      equalVariances: true,\n      isSignificant: true\n    };\n  }\n  if (totalN < k + 1) {\n    return {\n      fStatistic: 0,\n      pValue: 0,\n      dfBetween: 0,\n      dfWithin: 0,\n      ssBetween: 0,\n      ssWithin: 0,\n      msBetween: 0,\n      msWithin: 0,\n      rSquared: 0,\n      rSquaredAdj: 0,\n      rSquaredPred: 0,\n      pooledstdev: 0,\n      grandMean: 0,\n      groupMeans: [],\n      confidenceIntervals: [],\n      equalVariances: true,\n      isSignificant: true\n    };\n  }\n  const variancesTest = multipleSVarianceTest({\n    datasets,\n    normalityResults,\n    significanceLevel,\n    alternative\n  });\n  const groupMeans = datasets.map(\n    (group) => group.reduce((sum, val) => sum + val, 0) / group.length\n  );\n  const allValues = datasets.flat();\n  const grandMean = allValues.reduce((sum, val) => sum + val, 0) / totalN;\n  let ssBetween = 0;\n  for (let i = 0; i < k; i++) {\n    ssBetween += sampleSizes[i] * Math.pow(groupMeans[i] - grandMean, 2);\n  }\n  let ssWithin = 0;\n  for (let i = 0; i < k; i++) {\n    for (let j = 0; j < datasets[i].length; j++) {\n      ssWithin += Math.pow(datasets[i][j] - groupMeans[i], 2);\n    }\n  }\n  const dfBetween = k - 1;\n  const dfWithin = totalN - k;\n  const msBetween = ssBetween / dfBetween;\n  const msWithin = ssWithin / dfWithin;\n  const sst = ssBetween + ssWithin;\n  const rSquared = ssBetween / sst;\n  const rSquaredAdj = 1 - (1 - rSquared) * (totalN - 1) / (totalN - k);\n  const rSquaredPred = 1 - (1 - rSquared) * (totalN - k - 1) / (totalN - k - 1);\n  const pooledstdev = Math.sqrt(msWithin);\n  const fStatistic = msBetween / msWithin;\n  let pValue;\n  if (jStat && jStat.centralF) {\n    pValue = 1 - jStat.centralF.cdf(fStatistic, dfBetween, dfWithin);\n  } else {\n    console.warn(\"jStat not available, using approximation\");\n    if (fStatistic <= 0) pValue = 1;\n    else if (fStatistic < 1) pValue = 0.9 - 0.4 * fStatistic;\n    else if (fStatistic < 2) pValue = 0.5 - 0.3 * (fStatistic - 1);\n    else if (fStatistic < 3) pValue = 0.2 - 0.15 * (fStatistic - 2);\n    else if (fStatistic < 4) pValue = 0.05 - 0.03 * (fStatistic - 3);\n    else pValue = 0.02 * Math.exp(-(fStatistic - 4));\n  }\n  let tCritical;\n  if (jStat && jStat.studentt) {\n    tCritical = jStat.studentt.inv(1 - alpha / 2, dfWithin);\n  } else {\n    tCritical = alpha === 0.05 ? 1.96 : alpha === 0.01 ? 2.576 : 2.326;\n  }\n  const confidenceIntervals = datasets.map((dataset, i) => {\n    const n = sampleSizes[i];\n    const standardError = pooledstdev / Math.sqrt(n);\n    const margin = tCritical * standardError;\n    return {\n      lower: groupMeans[i] - margin,\n      upper: groupMeans[i] + margin\n    };\n  });\n  return {\n    fStatistic,\n    pValue,\n    dfBetween,\n    dfWithin,\n    ssBetween,\n    ssWithin,\n    msBetween,\n    msWithin,\n    rSquared,\n    rSquaredAdj,\n    rSquaredPred,\n    pooledstdev,\n    grandMean,\n    groupMeans,\n    confidenceIntervals,\n    equalVariances: variancesTest.pValue >= significanceLevel,\n    isSignificant: pValue < alpha\n  };\n}\nexport function bartlettTest(datasets, significanceLevel, alternative) {\n  if (datasets.length < 2) {\n    return {\n      varTestName: \"\",\n      varStatistic: 0,\n      varp_Value: 0,\n      varCriteria: 0,\n      varianceConfidenceIntervals: [],\n      vardfBarlett: 0,\n      varDF2: 0\n    };\n  }\n  const k = datasets.length;\n  const sampleSizes = datasets.map((group) => group.length);\n  const totalN = sampleSizes.reduce((sum, n) => sum + n, 0);\n  if (sampleSizes.some((n) => n < 2)) {\n    return {\n      varTestName: \"\",\n      varStatistic: 0,\n      varp_Value: 0,\n      varCriteria: 0,\n      varianceConfidenceIntervals: [],\n      vardfBarlett: 0,\n      varDF2: 0\n    };\n  }\n  const sampleVariances = datasets.map((group, i) => {\n    const mean2 = group.reduce((sum, val) => sum + val, 0) / group.length;\n    const sumSquaredDeviations = group.reduce((sum, val) => sum + Math.pow(val - mean2, 2), 0);\n    return sumSquaredDeviations / (group.length - 1);\n  });\n  const degreesOfFreedom = sampleSizes.map((n) => n - 1);\n  const totalDF = degreesOfFreedom.reduce((sum, df) => sum + df, 0);\n  const pooledVariance = degreesOfFreedom.reduce(\n    (sum, df, i) => sum + df * sampleVariances[i],\n    0\n  ) / totalDF;\n  const numerator = totalDF * Math.log(pooledVariance) - degreesOfFreedom.reduce((sum, df, i) => sum + df * Math.log(sampleVariances[i]), 0);\n  const correctionFactor = 1 + 1 / (3 * (k - 1)) * (degreesOfFreedom.reduce((sum, df) => sum + 1 / df, 0) - 1 / totalDF);\n  const bartlettStatistic = numerator / correctionFactor;\n  const dfBartlett = k - 1;\n  let pValue;\n  let criticalValue;\n  if (jStat && jStat.chisquare) {\n    pValue = 1 - jStat.chisquare.cdf(bartlettStatistic, dfBartlett);\n    criticalValue = jStat.chisquare.inv(1 - significanceLevel, dfBartlett);\n  } else {\n    console.warn(\"jStat not available for Bartlett test, using approximation\");\n    if (bartlettStatistic < 1) pValue = 0.9;\n    else if (bartlettStatistic < 3) pValue = 0.7 - 0.2 * (bartlettStatistic - 1);\n    else if (bartlettStatistic < 5) pValue = 0.3 - 0.2 * (bartlettStatistic - 3);\n    else if (bartlettStatistic < 7) pValue = 0.1 - 0.05 * (bartlettStatistic - 5);\n    else pValue = 0.01;\n    if (significanceLevel === 0.01) {\n      criticalValue = dfBartlett === 1 ? 6.635 : 9.21;\n    } else if (significanceLevel === 0.05) {\n      criticalValue = dfBartlett === 1 ? 3.841 : 5.991;\n    } else if (significanceLevel === 0.1) {\n      criticalValue = dfBartlett === 1 ? 2.706 : 4.605;\n    } else {\n      cr