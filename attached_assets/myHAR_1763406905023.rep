w);\\n}\\n.shadow-\\\\[0_0_0_1px_hsl\\\\(var\\\\(--sidebar-border\\\\)\\\\)\\\\] {\\n  --tw-shadow: 0 0 0 1px hsl(var(--sidebar-border));\\n  --tw-shadow-colored: 0 0 0 1px var(--tw-shadow-color);\\n  box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow);\\n}\\n.shadow-lg {\\n  --tw-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);\\n  --tw-shadow-colored: 0 10px 15px -3px var(--tw-shadow-color), 0 4px 6px -4px var(--tw-shadow-color);\\n  box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow);\\n}\\n.shadow-md {\\n  --tw-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);\\n  --tw-shadow-colored: 0 4px 6px -1px var(--tw-shadow-color), 0 2px 4px -2px var(--tw-shadow-color);\\n  box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow);\\n}\\n.shadow-none {\\n  --tw-shadow: 0 0 #0000;\\n  --tw-shadow-colored: 0 0 #0000;\\n  box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow);\\n}\\n.shadow-sm {\\n  --tw-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);\\n  --tw-shadow-colored: 0 1px 2px 0 var(--tw-shadow-color);\\n  box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow);\\n}\\n.shadow-xl {\\n  --tw-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);\\n  --tw-shadow-colored: 0 20px 25px -5px var(--tw-shadow-color), 0 8px 10px -6px var(--tw-shadow-color);\\n  box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow);\\n}\\n.outline-none {\\n  outline: 2px solid transparent;\\n  outline-offset: 2px;\\n}\\n.outline {\\n  outline-style: solid;\\n}\\n.ring {\\n  --tw-ring-offset-shadow: var(--tw-ring-inset) 0 0 0 var(--tw-ring-offset-width) var(--tw-ring-offset-color);\\n  --tw-ring-shadow: var(--tw-ring-inset) 0 0 0 calc(3px + var(--tw-ring-offset-width)) var(--tw-ring-color);\\n  box-shadow: var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow, 0 0 #0000);\\n}\\n.ring-0 {\\n  --tw-ring-offset-shadow: var(--tw-ring-inset) 0 0 0 var(--tw-ring-offset-width) var(--tw-ring-offset-color);\\n  --tw-ring-shadow: var(--tw-ring-inset) 0 0 0 calc(0px + var(--tw-ring-offset-width)) var(--tw-ring-color);\\n  box-shadow: var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow, 0 0 #0000);\\n}\\n.ring-2 {\\n  --tw-ring-offset-shadow: var(--tw-ring-inset) 0 0 0 var(--tw-ring-offset-width) var(--tw-ring-offset-color);\\n  --tw-ring-shadow: var(--tw-ring-inset) 0 0 0 calc(2px + var(--tw-ring-offset-width)) var(--tw-ring-color);\\n  box-shadow: var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow, 0 0 #0000);\\n}\\n.ring-blue-500 {\\n  --tw-ring-opacity: 1;\\n  --tw-ring-color: rgb(59 130 246 / var(--tw-ring-opacity, 1));\\n}\\n.ring-ring {\\n  --tw-ring-color: hsl(var(--ring));\\n}\\n.ring-sidebar-ring {\\n  --tw-ring-color: hsl(var(--sidebar-ring));\\n}\\n.ring-offset-background {\\n  --tw-ring-offset-color: hsl(var(--background));\\n}\\n.invert {\\n  --tw-invert: invert(100%);\\n  filter: var(--tw-blur) var(--tw-brightness) var(--tw-contrast) var(--tw-grayscale) var(--tw-hue-rotate) var(--tw-invert) var(--tw-saturate) var(--tw-sepia) var(--tw-drop-shadow);\\n}\\n.filter {\\n  filter: var(--tw-blur) var(--tw-brightness) var(--tw-contrast) var(--tw-grayscale) var(--tw-hue-rotate) var(--tw-invert) var(--tw-saturate) var(--tw-sepia) var(--tw-drop-shadow);\\n}\\n.transition {\\n  transition-property: color, background-color, border-color, text-decoration-color, fill, stroke, opacity, box-shadow, transform, filter, backdrop-filter;\\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n  transition-duration: 150ms;\\n}\\n.transition-\\\\[left\\\\2c right\\\\2c width\\\\] {\\n  transition-property: left,right,width;\\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n  transition-duration: 150ms;\\n}\\n.transition-\\\\[margin\\\\2c opacity\\\\] {\\n  transition-property: margin,opacity;\\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n  transition-duration: 150ms;\\n}\\n.transition-\\\\[width\\\\2c height\\\\2c padding\\\\] {\\n  transition-property: width,height,padding;\\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n  transition-duration: 150ms;\\n}\\n.transition-\\\\[width\\\\] {\\n  transition-property: width;\\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n  transition-duration: 150ms;\\n}\\n.transition-all {\\n  transition-property: all;\\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n  transition-duration: 150ms;\\n}\\n.transition-colors {\\n  transition-property: color, background-color, border-color, text-decoration-color, fill, stroke;\\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n  transition-duration: 150ms;\\n}\\n.transition-opacity {\\n  transition-property: opacity;\\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n  transition-duration: 150ms;\\n}\\n.transition-shadow {\\n  transition-property: box-shadow;\\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n  transition-duration: 150ms;\\n}\\n.transition-transform {\\n  transition-property: transform;\\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n  transition-duration: 150ms;\\n}\\n.duration-1000 {\\n  transition-duration: 1000ms;\\n}\\n.duration-150 {\\n  transition-duration: 150ms;\\n}\\n.duration-200 {\\n  transition-duration: 200ms;\\n}\\n.duration-300 {\\n  transition-duration: 300ms;\\n}\\n.ease-in-out {\\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n}\\n.ease-linear {\\n  transition-timing-function: linear;\\n}\\n@keyframes enter {\\n\\n  from {\\n    opacity: var(--tw-enter-opacity, 1);\\n    transform: translate3d(var(--tw-enter-translate-x, 0), var(--tw-enter-translate-y, 0), 0) scale3d(var(--tw-enter-scale, 1), var(--tw-enter-scale, 1), var(--tw-enter-scale, 1)) rotate(var(--tw-enter-rotate, 0));\\n  }\\n}\\n@keyframes exit {\\n\\n  to {\\n    opacity: var(--tw-exit-opacity, 1);\\n    transform: translate3d(var(--tw-exit-translate-x, 0), var(--tw-exit-translate-y, 0), 0) scale3d(var(--tw-exit-scale, 1), var(--tw-exit-scale, 1), var(--tw-exit-scale, 1)) rotate(var(--tw-exit-rotate, 0));\\n  }\\n}\\n.animate-in {\\n  animation-name: enter;\\n  animation-duration: 150ms;\\n  --tw-enter-opacity: initial;\\n  --tw-enter-scale: initial;\\n  --tw-enter-rotate: initial;\\n  --tw-enter-translate-x: initial;\\n  --tw-enter-translate-y: initial;\\n}\\n.fade-in-0 {\\n  --tw-enter-opacity: 0;\\n}\\n.fade-in-80 {\\n  --tw-enter-opacity: 0.8;\\n}\\n.zoom-in-95 {\\n  --tw-enter-scale: .95;\\n}\\n.duration-1000 {\\n  animation-duration: 1000ms;\\n}\\n.duration-150 {\\n  animation-duration: 150ms;\\n}\\n.duration-200 {\\n  animation-duration: 200ms;\\n}\\n.duration-300 {\\n  animation-duration: 300ms;\\n}\\n.ease-in-out {\\n  animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n}\\n.ease-linear {\\n  animation-timing-function: linear;\\n}\\n.running {\\n  animation-play-state: running;\\n}\\n\\n:root {\\n      --background: 0 0% 100%;\\n--foreground: 20 14.3% 4.1%;\\n--muted: 60 4.8% 95.9%;\\n--muted-foreground: 25 5.3% 44.7%;\\n--popover: 0 0% 100%;\\n--popover-foreground: 20 14.3% 4.1%;\\n--card: 0 0% 100%;\\n--card-foreground: 20 14.3% 4.1%;\\n--border: 20 5.9% 90%;\\n--input: 20 5.9% 90%;\\n--primary: 207 90% 54%;\\n--primary-foreground: 211 100% 99%;\\n--secondary: 60 4.8% 95.9%;\\n--secondary-foreground: 24 9.8% 10%;\\n--accent: 60 4.8% 95.9%;\\n--accent-foreground: 24 9.8% 10%;\\n--destructive: 0 84.2% 60.2%;\\n--destructive-foreground: 60 9.1% 97.8%;\\n--ring: 20 14.3% 4.1%;\\n--radius: 0.5rem;\\n  }\\n  .dark {\\n      --background: 240 10% 3.9%;\\n--foreground: 0 0% 98%;\\n--muted: 240 3.7% 15.9%;\\n--muted-foreground: 240 5% 64.9%;\\n--popover: 240 10% 3.9%;\\n--popover-foreground: 0 0% 98%;\\n--card: 240 10% 3.9%;\\n--card-foreground: 0 0% 98%;\\n--border: 240 3.7% 15.9%;\\n--input: 240 3.7% 15.9%;\\n--primary: 207 90% 54%;\\n--primary-foreground: 211 100% 99%;\\n--secondary: 240 3.7% 15.9%;\\n--secondary-foreground: 0 0% 98%;\\n--accent: 240 3.7% 15.9%;\\n--accent-foreground: 0 0% 98%;\\n--destructive: 0 62.8% 30.6%;\\n--destructive-foreground: 0 0% 98%;\\n--ring: 240 4.9% 83.9%;\\n--radius: 0.5rem;\\n  }\\n\\n/* PDF Export Styling */\\n.pdf-text {\\n  position: absolute;\\n  opacity: 0;\\n  pointer-events: none;\\n  z-index: -1;\\n}\\n\\n/* Hide elements during normal display that should only show in PDF */\\n.html2canvas-show {\\n  display: none !important;\\n}\\n\\n/* When PDF is being generated, adjust display properties */\\n.html2canvas-container .pdf-text {\\n  position: static;\\n  opacity: 1 !important;\\n  z-index: auto;\\n  pointer-events: auto;\\n  font-size: 14px;\\n  font-weight: normal;\\n  color: #000;\\n}\\n\\n.html2canvas-container .html2canvas-hide {\\n  display: none !important;\\n}\\n\\n.html2canvas-container .html2canvas-show {\\n  display: block !important;\\n}\\n\\n/* Hide FTE summary in PDF exports */\\n.html2canvas-container .hide-in-pdf-fte-summary {\\n  display: none !important;\\n}\\n\\n/* Hide standalone FTE summary text in PDF exports */\\n.html2canvas-container div span.fte-summary,\\n.html2canvas-container p.fte-summary {\\n  display: none !important;\\n}\\n\\n/* Hide any <p> with just FTE text between FTE Benefits and Total Financial Savings */\\n.html2canvas-container #fteBenefits,\\n.html2canvas-container input[name=\\\"fteBenefits\\\"],\\n.html2canvas-container *[value*=\\\"FTE (€\\\"] {\\n  visibility: hidden !important;\\n  height: 0 !important;\\n  min-height: 0 !important;\\n  padding: 0 !important;\\n  margin: 0 !important;\\n  overflow: hidden !important;\\n  display: none !important;\\n}\\n\\n/* Fix for title and input field spacing in PDF exports */\\n.html2canvas-container label {\\n  display: block !important;\\n  margin-bottom: 8px !important;\\n  font-weight: 500 !important;\\n  clear: both !important;\\n}\\n\\n.html2canvas-container input, \\n.html2canvas-container select, \\n.html2canvas-container textarea {\\n  margin-top: 4px !important;\\n  display: block !important;\\n  width: 100% !important;\\n}\\n\\n/* Project image specific styling to preserve original image size in PDF */\\n.html2canvas-container img {\\n  max-width: 100% !important;\\n  max-height: 300px !important;\\n  height: auto !important;\\n  width: auto !important;\\n  -o-object-fit: contain !important;\\n     object-fit: contain !important;\\n}\\n\\n/* FTE section specific styling for PDF export */\\n.html2canvas-container .html2canvas-show.print-hide {\\n  position: static !important;\\n  opacity: 1 !important;\\n  display: block !important;\\n  visibility: visible !important;\\n  left: auto !important;\\n  margin: 5px 0 !important;\\n  padding: 2px 5px !important;\\n  border-radius: 4px !important;\\n  background-color: #f5f5f5 !important;\\n  color: #333 !important;\\n  font-size: 12px !important;\\n  font-weight: normal !important;\\n}\\n\\n/* Special styling for form inputs when generating PDF */\\n.html2canvas-container input,\\n.html2canvas-container select,\\n.html2canvas-container textarea {\\n  border: 1px solid #e2e8f0 !important;\\n  background-color: white !important;\\n  color: #1e293b !important;\\n  font-family: inherit !important;\\n  opacity: 1 !important;\\n  \\n  /* Capture the value as text for better PDF rendering */\\n  position: relative !important;\\n}\\n\\n/* Hide interactive elements in PDF */\\n.html2canvas-container button,\\n.html2canvas-container [role=\\\"button\\\"] {\\n  opacity: 0 !important;\\n  position: absolute !important;\\n  pointer-events: none !important;\\n}\\n\\n/* Special styling for enhanced input display in PDF */\\n.html2canvas-container input::before,\\n.html2canvas-container textarea::before {\\n  content: attr(data-pdf-value);\\n  position: absolute;\\n  top: 0;\\n  left: 0;\\n  width: 100%;\\n  height: 100%;\\n  padding: 0.5rem;\\n  background: white;\\n  border: 1px solid #e2e8f0;\\n  border-radius: 0.25rem;\\n  color: #1e293b;\\n  z-index: 1;\\n}\\n\\n/* Styling for select elements in PDF */\\n.html2canvas-container select::before {\\n  content: attr(data-pdf-value);\\n  position: absolute;\\n  top: 0;\\n  left: 0;\\n  width: 100%;\\n  height: 100%;\\n  padding: 0.25rem 0.5rem;\\n  background: white;\\n  background-image: url(\\\"data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e\\\");\\n  background-position: right 0.5rem center;\\n  background-repeat: no-repeat;\\n  background-size: 1.5em 1.5em;\\n  border: 1px solid #e2e8f0;\\n  border-radius: 0.25rem;\\n  color: #1e293b;\\n  z-index: 1;\\n  line-height: 1rem;\\n  min-height: 1.4rem;\\n  max-height: none;\\n  font-size: 0.875rem;\\n}\\n\\n/* Special styling for PDF exports */\\n.html2canvas-container .pdf-select-value {\\n  margin-top: 4px;\\n  padding: 0.5rem;\\n  border: 1px solid #e2e8f0;\\n  border-radius: 0.25rem;\\n  background-color: white;\\n  color: #1e293b;\\n}\\n\\n.html2canvas-container [role=\\\"combobox\\\"] {\\n  position: relative;\\n}\\n\\n.html2canvas-container [role=\\\"combobox\\\"]::after {\\n  content: attr(data-pdf-value);\\n  position: absolute;\\n  top: 0;\\n  left: 0;\\n  width: 100%;\\n  height: 100%;\\n  display: flex;\\n  align-items: center;\\n  padding: 0 1rem;\\n  background: white;\\n  border: 1px solid #e2e8f0;\\n  border-radius: 0.25rem;\\n  color: #1e293b;\\n  z-index: 1;\\n}\\n\\n/* Add spacing for labels in PDF exports */\\n.html2canvas-container label {\\n  display: block;\\n  margin-bottom: 8px;\\n  font-weight: 500;\\n}\\n\\n/* Make inputs display properly in PDF exports */\\n.html2canvas-container input,\\n.html2canvas-container textarea {\\n  margin-top: 2px;\\n  margin-bottom: 8px;\\n  display: block;\\n  width: 100%;\\n  padding: 0.25rem 0.5rem;\\n  line-height: 1rem;\\n  min-height: 1.4rem;\\n  max-height: none;\\n  font-size: 0.875rem;\\n}\\n\\n/* Display only elements needed for PDF in html2canvas-container */\\n.html2canvas-container .html2canvas-hide {\\n  display: none !important;\\n}\\n\\n.html2canvas-container .html2canvas-show {\\n  display: block !important;\\n}\\n\\n/* Normal display (reverse of PDF display) */\\n.html2canvas-show {\\n  display: none !important;\\n}\\n\\n.html2canvas-hide {\\n  display: block;\\n}\\n\\n/* Make sure our containers for stakeholders and team members have correct display */\\n.stakeholder-table-container .html2canvas-show,\\n.team-member-table-container .html2canvas-show {\\n  display: none !important; /* Initially hidden but will be shown in PDF */\\n}\\n\\n.html2canvas-container .stakeholder-table-container .html2canvas-show,\\n.html2canvas-container .team-member-table-container .html2canvas-show {\\n  display: block !important; /* Force display during PDF export */\\n}\\n\\n.html2canvas-container .print-hide {\\n  display: none !important;\\n}\\n\\n.pdf-friendly-table {\\n  table-layout: fixed;\\n  width: 100%;\\n  border-collapse: collapse;\\n}\\n\\n.pdf-friendly-table th,\\n.pdf-friendly-table td {\\n  padding: 8px;\\n  text-align: left;\\n  vertical-align: middle;\\n  position: relative;\\n}\\n\\n/* More compact styling for PDF tables */\\n.pdf-friendly-table .compact-row td {\\n  padding: 3px 8px;\\n  line-height: 1.2;\\n}\\n\\n/* Styling for the simplified PDF stakeholder and team member lists */\\n.pdf-text-only-table {\\n  margin-bottom: 10px;\\n}\\n\\n.stakeholder-list-item,\\n.team-member-list-item {\\n  padding: 2px 0;\\n  line-height: 1.2;\\n}\\n\\n#stakeholders-pdf-table,\\n#team-members-pdf-table {\\n  margin-bottom: 5px;\\n}\\n\\n/* Styling for direct PDF lists generated during export */\\n.pdf-direct-list {\\n  margin: 10px 0;\\n  padding: 12px;\\n  border: 1px solid #e2e8f0;\\n  border-radius: 4px;\\n  background-color: #f8f9fa;\\n}\\n\\n/* Two-column table for PDF export - exactly matching requested format */\\n.two-column-pdf-table {\\n  width: 100%;\\n  border-collapse: collapse;\\n  margin-bottom: 15px;\\n  font-size: 14px;\\n  background-color: #fff;\\n  border-spacing: 0;\\n}\\n\\n.two-column-pdf-table th {\\n  color: #000;\\n  font-weight: 600;\\n  text-align: left;\\n  padding: 8px 12px;\\n  border-bottom: 1px solid #ddd;\\n  font-size: 14px;\\n}\\n\\n.two-column-pdf-table td {\\n  padding: 8px 12px;\\n  border-bottom: 1px solid #eee;\\n  vertical-align: top;\\n  text-align: left;\\n}\\n\\n/* Remove border from last row for cleaner look */\\n.two-column-pdf-table tr:last-child td {\\n  border-bottom: none;\\n}\\n\\n/* Special CSS for expanded sections in PDF exports */\\n.pdf-capture-target [data-state=\\\"open\\\"],\\n.pdf-capture-target [data-pdf-expanded=\\\"true\\\"] {\\n  /* Force expanded sections to show in PDFs */\\n  height: auto !important;\\n  visibility: visible !important;\\n  overflow: visible !important;\\n  opacity: 1 !important;\\n  display: block !important;\\n}\\n\\n/* Make sure all content inside expanded sections is visible */\\n.pdf-capture-target [data-state=\\\"open\\\"] [data-orientation=\\\"vertical\\\"],\\n.pdf-capture-target [data-pdf-expanded=\\\"true\\\"] [data-orientation=\\\"vertical\\\"] {\\n  height: auto !important;\\n  max-height: none !important;\\n  visibility: visible !important;\\n  overflow: visible !important;\\n  opacity: 1 !important;\\n  position: static !important;\\n  transform: none !important;\\n  clip-path: none !important;\\n  display: block !important;\\n}\\n\\n/* Make sure all the content is visible */\\n.pdf-capture-target [data-state=\\\"open\\\"] [data-orientation=\\\"vertical\\\"] > *,\\n.pdf-capture-target [data-pdf-expanded=\\\"true\\\"] [data-orientation=\\\"vertical\\\"] > * {\\n  visibility: visible !important;\\n  opacity: 1 !important;\\n  display: block !important;\\n}\\n\\n/* Special handling for Radix UI accordions */\\n.pdf-capture-target [data-radix-accordion-content] {\\n  height: auto !important;\\n  overflow: visible !important;\\n  opacity: 1 !important;\\n  visibility: visible !important;\\n  transform: none !important;\\n  display: block !important;\\n}\\n\\n/* Risk Assessment Textareas */\\n.risk-mitigation-textarea {\\n  min-height: 120px;\\n  overflow-y: auto;\\n  resize: vertical;\\n  resize-handle: border-bottom;\\n}\\n\\n.risk-name-textarea {\\n  min-height: 24px;\\n  overflow-y: auto;\\n  resize: vertical;\\n  resize-handle: border-bottom;\\n}\\n\\n.risk-owner-textarea {\\n  min-height: 24px;\\n  overflow-y: auto;\\n  resize: vertical;\\n  resize-handle: border-bottom;\\n}\\n\\n/* Risk Assessment Row container */\\n.risk-row {\\n  display: grid;\\n  grid-template-columns: repeat(12, 1fr);\\n  gap: 0.25rem;\\n  margin-bottom: 0.5rem;\\n  position: relative;\\n}\\n\\n@media print {\\n  input, button, select, textarea {\\n    display: none !important;\\n  }\\n  \\n  .pdf-text {\\n    position: static;\\n    opacity: 1;\\n    z-index: auto;\\n    pointer-events: auto;\\n  }\\n  \\n  .print-hide {\\n    display: none !important;\\n  }\\n  \\n  /* Force expanded sections to be visible when printing */\\n  [data-state=\\\"open\\\"] [data-orientation=\\\"vertical\\\"] {\\n    height: auto !important;\\n    max-height: none !important;\\n    visibility: visible !important;\\n    overflow: visible !important;\\n    opacity: 1 !important;\\n    position: static !important;\\n    transform: none !important;\\n    display: block !important;\\n  }\\n}\\n\\n/* PDF Stakeholder and Team Member Flex Tables */\\n.stakeholder-pdf-header, .team-member-pdf-header {\\n  border-bottom: 1px solid #ddd;\\n  margin-bottom: 8px;\\n  padding-bottom: 4px;\\n}\\n\\n.stakeholder-pdf-table, .team-member-pdf-table {\\n  width: 100%;\\n  border: 1px solid #eee;\\n  border-radius: 4px;\\n  padding: 10px;\\n  background-color: white;\\n}\\n\\n.stakeholder-pdf-row, .team-member-pdf-row {\\n  padding: 4px 0;\\n}\\n\\n/* Fixed PDF Tables with headers */\\n.fixed-pdf-table {\\n  width: 100%;\\n  border-collapse: collapse;\\n  border-spacing: 0;\\n}\\n\\n.fixed-pdf-table th {\\n  text-align: left;\\n  font-weight: 600;\\n  padding: 6px 10px;\\n  background-color: #f9fafb;\\n  border-bottom: 1px solid #ddd;\\n  font-size: 15px;\\n}\\n\\n.fixed-pdf-table td {\\n  padding: 6px 10px;\\n  text-align: left;\\n  border-bottom: 1px solid #eee;\\n  font-size: 14px;\\n}\\n\\n.fixed-pdf-table tr:last-child td {\\n  border-bottom: none;\\n}\\n\\n/* MyComponent.css */\\n.iframe-container {\\n  position: relative; /* Essential for absolute positioning of child */\\n  width: 100%; /* Adjust as needed */\\n  margin: 0 auto; /* Center the container */\\n  /*padding-top: 50px; /* Example: Push content down from the top */\\n  height: 600px; /* Set a height or let content define it */\\n  /*border: 1px solid #ccc; */\\n  overflow: hidden !important;\\n  display: block; /* Removes extra spacing */\\n}\\n\\n.my-iframe {\\n  position: absolute; /* Position within the relative container */\\n  /*top: 20px; /* Example: 20px from the top of the container */\\n  /*left: 20px; /* Example: 20px from the left of the container */\\n  width: calc(100% - 0px); /* Adjust width to fit container */\\n  height: calc(100% - 0px); /* Adjust height to fit container */\\n  border: none;\\n}\\n\\n.file\\\\:border-0::file-selector-button {\\n  border-width: 0px;\\n}\\n\\n.file\\\\:bg-transparent::file-selector-button {\\n  background-color: transparent;\\n}\\n\\n.file\\\\:text-sm::file-selector-button {\\n  font-size: 0.875rem;\\n  line-height: 1.25rem;\\n}\\n\\n.file\\\\:font-medium::file-selector-button {\\n  font-weight: 500;\\n}\\n\\n.file\\\\:text-foreground::file-selector-button {\\n  color: hsl(var(--foreground));\\n}\\n\\n.placeholder\\\\:text-\\\\[12px\\\\]::-moz-placeholder {\\n  font-size: 12px;\\n}\\n\\n.placeholder\\\\:text-\\\\[12px\\\\]::placeholder {\\n  font-size: 12px;\\n}\\n\\n.placeholder\\\\:text-muted-foreground::-moz-placeholder {\\n  color: hsl(var(--muted-foreground));\\n}\\n\\n.placeholder\\\\:text-muted-foreground::placeholder {\\n  color: hsl(var(--muted-foreground));\\n}\\n\\n.after\\\\:absolute::after {\\n  content: var(--tw-content);\\n  position: absolute;\\n}\\n\\n.after\\\\:-inset-2::after {\\n  content: var(--tw-content);\\n  inset: -0.5rem;\\n}\\n\\n.after\\\\:inset-y-0::after {\\n  content: var(--tw-content);\\n  top: 0px;\\n  bottom: 0px;\\n}\\n\\n.after\\\\:left-1\\\\/2::after {\\n  content: var(--tw-content);\\n  left: 50%;\\n}\\n\\n.after\\\\:w-1::after {\\n  content: var(--tw-content);\\n  width: 0.25rem;\\n}\\n\\n.after\\\\:w-\\\\[2px\\\\]::after {\\n  content: var(--tw-content);\\n  width: 2px;\\n}\\n\\n.after\\\\:-translate-x-1\\\\/2::after {\\n  content: var(--tw-content);\\n  --tw-translate-x: -50%;\\n  transform: translate(var(--tw-translate-x), var(--tw-translate-y)) rotate(var(--tw-rotate)) skewX(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y));\\n}\\n\\n.first\\\\:rounded-l-md:first-child {\\n  border-top-left-radius: calc(var(--radius) - 2px);\\n  border-bottom-left-radius: calc(var(--radius) - 2px);\\n}\\n\\n.first\\\\:border-l:first-child {\\n  border-left-width: 1px;\\n}\\n\\n.last\\\\:mb-0:last-child {\\n  margin-bottom: 0px;\\n}\\n\\n.last\\\\:rounded-r-md:last-child {\\n  border-top-right-radius: calc(var(--radius) - 2px);\\n  border-bottom-right-radius: calc(var(--radius) - 2px);\\n}\\n\\n.last\\\\:border-b-0:last-child {\\n  border-bottom-width: 0px;\\n}\\n\\n.focus-within\\\\:relative:focus-within {\\n  position: relative;\\n}\\n\\n.focus-within\\\\:z-20:focus-within {\\n  z-index: 20;\\n}\\n\\n.hover\\\\:scale-110:hover {\\n  --tw-scale-x: 1.1;\\n  --tw-scale-y: 1.1;\\n  transform: translate(var(--tw-translate-x), var(--tw-transla